<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Johto & Kanto Team Builder</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0e0a;--surface:#111811;--surface2:#172017;
  --border:#2a3d2a;--border-hi:#4a6a4a;
  --green:#5dfc8d;--green-dim:#2a7a4a;--green-glow:rgba(93,252,141,0.12);
  --yellow:#f5e642;--red:#fc5d5d;--blue:#5db8fc;--orange:#fcb45d;
  --text:#c8dcc8;--text-dim:#5a7a5a;
  --scan:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.08) 2px,rgba(0,0,0,0.08) 4px);
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'Press Start 2P',monospace;font-size:10px;line-height:1.7;min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:var(--scan);pointer-events:none;z-index:9998;opacity:0.6}

/* NAV */
nav{border-bottom:2px solid var(--border);background:var(--surface);position:sticky;top:0;z-index:200;display:flex;align-items:stretch;overflow-x:auto;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
.nav-logo{padding:0 16px;font-size:10px;color:var(--green);text-shadow:0 0 12px rgba(93,252,141,0.5);white-space:nowrap;display:flex;align-items:center;border-right:2px solid var(--border);letter-spacing:0.06em}
.nav-logo span{color:var(--yellow)}
.nav-tabs{display:flex}
.nav-tab{font-family:'Press Start 2P',monospace;font-size:7px;padding:0 14px;height:46px;border:none;border-right:2px solid var(--border);background:none;color:var(--text-dim);cursor:pointer;white-space:nowrap;letter-spacing:0.05em;transition:all 0.1s;display:flex;align-items:center;gap:5px}
.nav-tab:hover{background:var(--surface2);color:var(--text)}
.nav-tab.active{background:var(--green-glow);color:var(--green);border-bottom:2px solid var(--green)}
.header-preview{display:flex;gap:4px;align-items:center;padding:0 12px;margin-left:auto;border-left:2px solid var(--border)}
.htp-slot{width:28px;height:28px;border:2px solid var(--border);background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:14px}
.htp-slot.filled{border-color:var(--green-dim)}

/* PAGE SYSTEM */
.page{display:none}
.page.active{display:block}

/* ========== SHARED STYLES ========== */
.sec-label{font-size:7px;color:var(--text-dim);letter-spacing:0.25em;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.sec-label::after{content:'';flex:1;height:1px;background:var(--border)}
.search-input{width:100%;background:var(--bg);border:2px solid var(--border);color:var(--green);font-family:'Press Start 2P',monospace;font-size:8px;padding:8px 10px;outline:none;margin-bottom:14px;caret-color:var(--green)}
.search-input::placeholder{color:var(--text-dim)}
.search-input:focus{border-color:var(--green-dim);box-shadow:0 0 0 2px var(--green-glow)}
.t-btn{font-family:'Press Start 2P',monospace;font-size:6px;padding:4px 3px;border:2px solid transparent;cursor:pointer;color:white;text-shadow:1px 1px 0 rgba(0,0,0,0.6);letter-spacing:0.04em;text-align:center}
.t-btn:hover{filter:brightness(1.2)}
.t-btn.on{border-color:white;filter:brightness(1.3)}
.clear-btn{width:100%;font-family:'Press Start 2P',monospace;font-size:7px;padding:6px;background:var(--surface2);border:2px solid var(--border);color:var(--text-dim);cursor:pointer;margin-top:4px}
.clear-btn:hover{border-color:var(--border-hi);color:var(--text)}
.sort-row{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-bottom:14px}
.sort-btn{font-family:'Press Start 2P',monospace;font-size:6px;padding:5px 4px;background:var(--surface2);border:2px solid var(--border);color:var(--text-dim);cursor:pointer;text-align:center}
.sort-btn:hover{border-color:var(--border-hi);color:var(--text)}
.sort-btn.on{border-color:var(--green-dim);color:var(--green);background:var(--green-glow)}
.type-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-bottom:10px}
.poke-card{background:var(--surface);border:2px solid var(--border);padding:10px 8px 8px;text-align:center;cursor:pointer;transition:border-color 0.15s,background 0.15s,transform 0.1s;position:relative;user-select:none}
.poke-card:hover{border-color:var(--border-hi);transform:translateY(-1px)}
.poke-card.in-team{border-color:var(--green);background:var(--green-glow)}
.poke-card.in-team::after{content:'✓';position:absolute;top:3px;right:5px;font-size:8px;color:var(--green)}
.poke-card.locked{opacity:0.35;cursor:not-allowed;transform:none!important}
.pc-num{font-size:6px;color:var(--text-dim);display:block;margin-bottom:3px}
.pc-sprite{font-size:2rem;display:block;margin-bottom:5px;line-height:1}
.pc-name{font-size:7px;color:var(--text);display:block;margin-bottom:6px;letter-spacing:0.03em}
.pc-types{display:flex;gap:2px;justify-content:center;flex-wrap:wrap}
.t-chip{font-family:'Press Start 2P',monospace;font-size:5px;padding:2px 4px;color:white;text-shadow:1px 1px 0 rgba(0,0,0,0.5);letter-spacing:0.03em}
.poke-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:6px}
.count-bar{font-size:7px;color:var(--text-dim);margin-bottom:12px;letter-spacing:0.1em}
.count-bar span{color:var(--green)}
.no-res{font-size:8px;color:var(--text-dim);text-align:center;padding:3rem 1rem;grid-column:1/-1;line-height:2}
.action-btn{flex:1;font-family:'Press Start 2P',monospace;font-size:7px;padding:7px 4px;border:2px solid var(--border);background:var(--surface2);color:var(--text);cursor:pointer;transition:all 0.15s;letter-spacing:0.03em}
.action-btn:hover:not(:disabled){border-color:var(--border-hi)}
.action-btn.primary{background:var(--green-glow);border-color:var(--green-dim);color:var(--green)}
.action-btn.primary:hover:not(:disabled){background:rgba(93,252,141,0.2);border-color:var(--green)}
.action-btn:disabled{opacity:0.3;cursor:not-allowed}

/* ========== BUILDER LAYOUT ========== */
.builder-wrap{display:grid;grid-template-columns:240px 1fr 270px;min-height:calc(100vh - 46px)}
.b-left{border-right:2px solid var(--border);padding:14px;overflow-y:auto;max-height:calc(100vh - 46px);position:sticky;top:46px}
.b-mid{padding:14px;overflow-y:auto;max-height:calc(100vh - 46px)}
.b-right{border-left:2px solid var(--border);padding:14px;overflow-y:auto;max-height:calc(100vh - 46px);position:sticky;top:46px}

/* REGION TAB inside builder */
.region-tabs{display:flex;gap:0;margin-bottom:14px;border:2px solid var(--border)}
.region-tab{flex:1;font-family:'Press Start 2P',monospace;font-size:7px;padding:6px 4px;border:none;cursor:pointer;text-align:center;letter-spacing:0.05em}
.region-tab.johto{background:var(--surface2);color:var(--yellow)}
.region-tab.kanto{background:var(--surface2);color:var(--blue)}
.region-tab.both{background:var(--surface2);color:var(--green)}
.region-tab.active{filter:brightness(1.4);border-bottom:3px solid currentColor}

/* TEAM */
.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:10px}
.team-slot{border:2px dashed var(--border);padding:8px 6px;text-align:center;min-height:80px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;background:var(--bg)}
.team-slot.filled{border-style:solid;border-color:var(--green-dim);background:var(--surface)}
.team-slot .empty-txt{font-size:6px;color:var(--text-dim);line-height:1.8}
.ts-sprite{font-size:1.8rem;display:block}
.ts-name{font-size:6px;color:var(--text);margin-top:3px;display:block}
.ts-types{display:flex;gap:2px;justify-content:center;margin-top:4px;flex-wrap:wrap}
.ts-rm{position:absolute;top:2px;right:3px;font-family:'Press Start 2P',monospace;font-size:5px;background:transparent;border:none;color:var(--text-dim);cursor:pointer;padding:2px;line-height:1}
.ts-rm:hover{color:var(--red)}
.team-actions{display:flex;gap:6px;margin-bottom:14px}
.coverage-row{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:14px}
.cov-tag{font-size:5px;padding:2px 5px;color:white;text-shadow:1px 1px 0 rgba(0,0,0,0.5);font-family:'Press Start 2P',monospace;opacity:0.85}
.eval-box{border:2px solid var(--border);background:var(--bg);padding:12px}
.eval-empty{text-align:center;padding:16px 0;font-size:7px;color:var(--text-dim);line-height:2}
.eval-content{font-family:'VT323',monospace;font-size:17px;color:var(--text);line-height:1.55}
.eval-score-row{display:flex;align-items:center;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border)}
.big-score{font-family:'Press Start 2P',monospace;font-size:28px;line-height:1}
.score-label{font-size:14px;color:var(--text-dim)}
.eval-section{margin-bottom:12px}
.eval-section-title{font-family:'Press Start 2P',monospace;font-size:7px;letter-spacing:0.1em;margin-bottom:6px;padding-bottom:4px;border-bottom:1px solid var(--border)}
.eval-section-title.good{color:var(--green)}
.eval-section-title.bad{color:var(--red)}
.eval-section-title.neutral{color:var(--yellow)}
.dot-anim span{display:inline-block;color:var(--green);font-size:14px;animation:dotbounce 1.2s ease-in-out infinite}
.dot-anim span:nth-child(2){animation-delay:0.2s}
.dot-anim span:nth-child(3){animation-delay:0.4s}
@keyframes dotbounce{0%,80%,100%{transform:translateY(0)}40%{transform:translateY(-6px)}}
@keyframes glow-pulse{0%,100%{box-shadow:0 0 6px rgba(93,252,141,0.15)}50%{box-shadow:0 0 18px rgba(93,252,141,0.35)}}
.eval-box.glowing{animation:glow-pulse 2s ease-in-out 3}

/* MODAL */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.88);z-index:500;align-items:center;justify-content:center;padding:1rem}
.modal-bg.open{display:flex}
.modal{background:var(--surface);border:3px solid var(--green-dim);box-shadow:0 0 40px rgba(93,252,141,0.1);max-width:440px;width:100%;max-height:85vh;overflow-y:auto;padding:20px;position:relative}
.modal-close{position:absolute;top:8px;right:10px;font-family:'Press Start 2P',monospace;font-size:8px;background:none;border:none;color:var(--text-dim);cursor:pointer;padding:4px}
.modal-close:hover{color:var(--red)}
.modal-sprite{font-size:3.5rem;text-align:center;display:block;margin-bottom:8px}
.modal-name{font-size:14px;color:var(--green);text-align:center;text-shadow:0 0 10px rgba(93,252,141,0.4)}
.modal-num{font-size:7px;color:var(--text-dim);text-align:center;margin:4px 0 10px}
.modal-types-row{display:flex;gap:5px;justify-content:center;margin-bottom:14px}
.modal-sec-title{font-size:7px;color:var(--yellow);letter-spacing:0.1em;margin-bottom:6px;margin-top:12px;border-bottom:1px solid var(--border);padding-bottom:4px}
.modal-desc{font-family:'VT323',monospace;font-size:17px;color:var(--text);line-height:1.5;margin-bottom:10px}
.stat-row{display:flex;align-items:center;gap:6px;margin-bottom:5px}
.stat-lbl{font-size:6px;color:var(--text-dim);width:42px;flex-shrink:0}
.stat-bar-bg{flex:1;height:9px;background:var(--bg);border:1px solid var(--border)}
.stat-bar{height:100%;transition:width 0.5s}
.stat-val{font-size:6px;color:var(--text);width:26px;text-align:right;flex-shrink:0}
.ability-item{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
.ability-name{font-family:'VT323',monospace;font-size:16px;color:var(--text)}
.ability-badge{font-size:6px;padding:2px 6px;border:1px solid var(--green-dim);color:var(--green);background:var(--green-glow)}
.ability-badge.hidden{border-color:#a06000;color:var(--yellow);background:rgba(245,230,66,0.08)}
.modal-add-btn{width:100%;margin-top:14px;font-family:'Press Start 2P',monospace;font-size:8px;padding:9px;border:2px solid var(--green-dim);background:var(--green-glow);color:var(--green);cursor:pointer;transition:all 0.15s;letter-spacing:0.05em}
.modal-add-btn:hover:not(:disabled){background:rgba(93,252,141,0.2);border-color:var(--green)}
.modal-add-btn.remove{border-color:#7a1a1a;background:rgba(252,93,93,0.08);color:var(--red)}
.modal-add-btn:disabled{opacity:0.3;cursor:not-allowed}
.modal-fav-btn{width:100%;margin-top:6px;font-family:'Press Start 2P',monospace;font-size:8px;padding:8px;border:2px solid #7a6000;background:rgba(245,230,66,0.07);color:var(--yellow);cursor:pointer;transition:all 0.15s}
.modal-fav-btn:hover{background:rgba(245,230,66,0.15)}

/* ========== TRAINER CREATOR ========== */
.trainer-page{padding:20px;max-width:760px;margin:0 auto}
.trainer-layout{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start}
.trainer-canvas-wrap{display:flex;flex-direction:column;align-items:center;gap:12px}
#trainerCanvas{border:3px solid var(--green-dim);background:var(--surface);image-rendering:pixelated;cursor:default}
.trainer-controls{background:var(--surface);border:2px solid var(--border);padding:16px}
.ctrl-group{margin-bottom:16px}
.ctrl-label{font-size:7px;color:var(--text-dim);letter-spacing:0.2em;margin-bottom:8px;display:block}
.swatch-row{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:6px}
.swatch{width:22px;height:22px;border:2px solid var(--border);cursor:pointer;transition:transform 0.1s}
.swatch:hover{transform:scale(1.15)}
.swatch.active{border-color:white;transform:scale(1.15)}
.option-row{display:flex;gap:4px;flex-wrap:wrap}
.opt-btn{font-family:'Press Start 2P',monospace;font-size:6px;padding:4px 8px;background:var(--surface2);border:2px solid var(--border);color:var(--text-dim);cursor:pointer}
.opt-btn:hover{border-color:var(--border-hi);color:var(--text)}
.opt-btn.active{border-color:var(--green-dim);color:var(--green);background:var(--green-glow)}
.quote-input{width:100%;background:var(--bg);border:2px solid var(--border);color:var(--green);font-family:'Press Start 2P',monospace;font-size:7px;padding:8px;outline:none;resize:none;height:60px;caret-color:var(--green)}
.quote-input:focus{border-color:var(--green-dim)}
.trainer-name-input{width:100%;background:var(--bg);border:2px solid var(--border);color:var(--green);font-family:'Press Start 2P',monospace;font-size:8px;padding:7px;outline:none;margin-bottom:8px;caret-color:var(--green)}
.save-trainer-btn{width:100%;font-family:'Press Start 2P',monospace;font-size:8px;padding:9px;border:2px solid var(--green-dim);background:var(--green-glow);color:var(--green);cursor:pointer;margin-top:8px}
.save-trainer-btn:hover{background:rgba(93,252,141,0.2)}
.trainer-card-saved{border:2px solid var(--border);background:var(--surface);padding:14px;text-align:center;margin-top:12px}
.trainer-card-saved .tcs-name{font-size:10px;color:var(--green);margin-bottom:6px}
.trainer-card-saved .tcs-quote{font-family:'VT323',monospace;font-size:18px;color:var(--text);font-style:italic;line-height:1.4}

/* ========== FAVOURITES ========== */
.favs-page{padding:20px;max-width:900px;margin:0 auto}
.fav-form{background:var(--surface);border:2px solid var(--border);padding:16px;margin-bottom:20px}
.fav-form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.fav-select{width:100%;background:var(--bg);border:2px solid var(--border);color:var(--green);font-family:'Press Start 2P',monospace;font-size:7px;padding:7px;outline:none;cursor:pointer}
.fav-select:focus{border-color:var(--green-dim)}
.fav-textarea{width:100%;background:var(--bg);border:2px solid var(--border);color:var(--text);font-family:'VT323',monospace;font-size:18px;padding:10px;outline:none;resize:vertical;min-height:80px;caret-color:var(--green);line-height:1.5}
.fav-textarea::placeholder{color:var(--text-dim)}
.fav-textarea:focus{border-color:var(--green-dim)}
.fav-submit{font-family:'Press Start 2P',monospace;font-size:8px;padding:9px 16px;border:2px solid var(--green-dim);background:var(--green-glow);color:var(--green);cursor:pointer}
.fav-submit:hover{background:rgba(93,252,141,0.2)}
.favs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.fav-card{background:var(--surface);border:2px solid var(--border);padding:14px;position:relative;transition:border-color 0.2s}
.fav-card:hover{border-color:var(--border-hi)}
.fav-card-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.fav-sprite{font-size:2.5rem;flex-shrink:0}
.fav-info{}
.fav-name{font-size:8px;color:var(--green);display:block;margin-bottom:3px}
.fav-num{font-size:6px;color:var(--text-dim)}
.fav-types{display:flex;gap:3px;margin-top:4px;flex-wrap:wrap}
.fav-reason{font-family:'VT323',monospace;font-size:17px;color:var(--text);line-height:1.55;border-top:1px solid var(--border);padding-top:8px;margin-top:2px}
.fav-del{position:absolute;top:6px;right:8px;font-family:'Press Start 2P',monospace;font-size:6px;background:none;border:none;color:var(--text-dim);cursor:pointer;padding:3px}
.fav-del:hover{color:var(--red)}
.fav-date{font-size:5px;color:var(--text-dim);margin-top:6px;letter-spacing:0.1em}
.fav-empty{text-align:center;padding:3rem;font-size:8px;color:var(--text-dim);line-height:2.5;grid-column:1/-1}

/* SCROLLBAR */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--border)}
::-webkit-scrollbar-thumb:hover{background:var(--border-hi)}

@media(max-width:800px){
  .builder-wrap{grid-template-columns:1fr}
  .b-left,.b-right,.b-mid{max-height:none;position:static;border:none;border-bottom:2px solid var(--border)}
  .trainer-layout{grid-template-columns:1fr}
  .fav-form-row{grid-template-columns:1fr}
}
</style>
</head>
<body>

<nav>
  <div class="nav-logo">⚔ <span>PKMN</span> APP</div>
  <div class="nav-tabs">
    <button class="nav-tab active" onclick="showPage('builder')">🗡 TEAM BUILDER</button>
    <button class="nav-tab" onclick="showPage('trainer')">🧑 MY TRAINER</button>
    <button class="nav-tab" onclick="showPage('favs')">⭐ FAVOURITES</button>
  </div>
  <div class="header-preview" id="headerPreview"></div>
</nav>

<!-- ============================================================
     PAGE: TEAM BUILDER
============================================================ -->
<div id="page-builder" class="page active">
<div class="builder-wrap">

  <!-- LEFT FILTER -->
  <div class="b-left">
    <div class="sec-label">REGION</div>
    <div class="region-tabs">
      <button class="region-tab johto active" id="rtab-johto" onclick="setRegion('johto')">JOHTO</button>
      <button class="region-tab kanto" id="rtab-kanto" onclick="setRegion('kanto')">KANTO</button>
      <button class="region-tab both" id="rtab-both" onclick="setRegion('both')">BOTH</button>
    </div>
    <div class="sec-label">SEARCH</div>
    <input class="search-input" id="searchInput" type="text" placeholder="MON NAME..." oninput="render()">
    <div class="sec-label">SORT BY</div>
    <div class="sort-row">
      <button class="sort-btn on" id="sort-num" onclick="setSort('num')">NO.</button>
      <button class="sort-btn" id="sort-bst" onclick="setSort('bst')">BST↓</button>
      <button class="sort-btn" id="sort-atk" onclick="setSort('atk')">ATK↓</button>
      <button class="sort-btn" id="sort-spd" onclick="setSort('spd')">SPD↓</button>
    </div>
    <div class="sec-label">TYPE</div>
    <div class="type-grid" id="typeGrid"></div>
    <button class="clear-btn" onclick="clearType()">CLEAR FILTER</button>
  </div>

  <!-- MIDDLE GRID -->
  <div class="b-mid">
    <div class="count-bar" id="countBar">Loading...</div>
    <div class="poke-grid" id="pokeGrid"></div>
  </div>

  <!-- RIGHT TEAM + EVAL -->
  <div class="b-right">
    <div class="sec-label">YOUR TEAM (<span id="teamCt">0</span>/6)</div>
    <div class="team-grid" id="teamGrid"></div>
    <div class="sec-label">TYPE COVERAGE</div>
    <div class="coverage-row" id="coverageRow"><span style="font-size:7px;color:var(--text-dim)">Add Pokémon to see coverage</span></div>
    <div class="team-actions">
      <button class="action-btn" onclick="clearTeam()">✖ CLEAR</button>
      <button class="action-btn primary" id="evalBtn" onclick="evaluateTeam()" disabled>▶ ANALYSE</button>
    </div>
    <div class="sec-label">TEAM ANALYSIS</div>
    <div class="eval-box" id="evalBox">
      <div class="eval-empty">Add Pokémon &amp; hit<br>ANALYSE TEAM</div>
    </div>
  </div>
</div>
</div>

<!-- ============================================================
     PAGE: TRAINER CREATOR
============================================================ -->
<div id="page-trainer" class="page">
<div class="trainer-page">
  <div class="sec-label" style="margin-bottom:16px">MY TRAINER</div>
  <div class="trainer-layout">

    <div class="trainer-canvas-wrap">
      <canvas id="trainerCanvas" width="160" height="200"></canvas>
      <div id="trainerCardSaved" class="trainer-card-saved" style="display:none;width:100%">
        <div class="tcs-name" id="savedTrainerName"></div>

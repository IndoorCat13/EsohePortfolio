rebuildTypeGrid();
render();
updateTeam();
initTrainer();
populateFavSelect();
renderFavs();
document.getElementById('favRegionSelect').onchange=populateFavSelect;
document.getElementById('trainerNameInput').oninput=drawTrainer;

const ALL_MONS = [...JOHTO_MONS, ...KANTO_MONS];

// ===== STATE =====
const TC_LIST = [...new Set(ALL_MONS.flatMap(m => m.t))].sort();
let activeType = null;
let sortMode = 'num';
let team = [];
let modalMon = null;
let currentRegion = 'johto';
let favourites = JSON.parse(localStorage.getItem('pkmn_favs') || '[]');
let trainerData = JSON.parse(localStorage.getItem('pkmn_trainer') || 'null');

// ===== NAVIGATION =====
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  const tabs = document.querySelectorAll('.nav-tab');
  if (id === 'builder') tabs[0].classList.add('active');
  if (id === 'trainer') { tabs[1].classList.add('active'); drawTrainer(); }
  if (id === 'favs') { tabs[2].classList.add('active'); renderFavs(); }
}

// ===== REGION =====
function setRegion(r) {
  currentRegion = r;
  ['johto','kanto','both'].forEach(x => document.getElementById('rtab-'+x).classList.remove('active'));
  document.getElementById('rtab-'+r).classList.add('active');
  rebuildTypeGrid();
  render();
}

function getActiveMons() {
  if (currentRegion === 'johto') return JOHTO_MONS;
  if (currentRegion === 'kanto') return KANTO_MONS;
  return ALL_MONS;
}

// ===== TYPE FILTER =====
function rebuildTypeGrid() {
  const g = document.getElementById('typeGrid');
  g.innerHTML = '';
  const types = [...new Set(getActiveMons().flatMap(m => m.t))].sort();
  if (!types.includes(activeType)) activeType = null;
  types.forEach(tp => {
    const b = document.createElement('button');
    b.className = 't-btn';
    b.dataset.t = tp;
    b.textContent = tp.toUpperCase();
    b.style.background = TC[tp] || '#555';
    if (activeType === tp) b.classList.add('on');
    b.onclick = () => {
      activeType = activeType === tp ? null : tp;
      document.querySelectorAll('.t-btn').forEach(x => x.classList.toggle('on', x.dataset.t === activeType));
      render();
    };
    g.appendChild(b);
  });
}

function clearType() {
  activeType = null;
  document.querySelectorAll('.t-btn').forEach(x => x.classList.remove('on'));
  render();
}

function setSort(m) {
  sortMode = m;
  document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('on'));
  document.getElementById('sort-' + m).classList.add('on');
  render();
}

// ===== RENDER POKEMON GRID =====
function render() {
  const q = document.getElementById('searchInput').value.toLowerCase().trim();
  const teamFull = team.length >= 6;
  let list = getActiveMons().filter(m => {
    return m.name.toLowerCase().includes(q) && (!activeType || m.t.includes(activeType));
  });
  if (sortMode === 'bst') list.sort((a,b) => b.bst - a.bst);
  else if (sortMode === 'atk') list.sort((a,b) => b.st.atk - a.st.atk);
  else if (sortMode === 'spd') list.sort((a,b) => b.st.spd - a.st.spd);
  else list.sort((a,b) => a.id - b.id);

  document.getElementById('countBar').innerHTML = `<span>${list.length}</span> Pokémon · ${currentRegion.toUpperCase()}`;
  const grid = document.getElementById('pokeGrid');
  grid.innerHTML = '';
  if (!list.length) { grid.innerHTML = '<div class="no-res">NO MON FOUND</div>'; return; }

  list.forEach(m => {
    const inTeam = team.some(t => t.id === m.id);
    const card = document.createElement('div');
    card.className = 'poke-card' + (inTeam ? ' in-team' : '') + (teamFull && !inTeam ? ' locked' : '');
    const regionBadge = m.region === 'kanto' ? `<span style="position:absolute;top:3px;left:4px;font-size:5px;color:var(--blue);font-family:'Press Start 2P',monospace">K</span>` : `<span style="position:absolute;top:3px;left:4px;font-size:5px;color:var(--yellow);font-family:'Press Start 2P',monospace">J</span>`;
    card.innerHTML = `${currentRegion==='both'?regionBadge:''}
      <span class="pc-num">#${String(m.id).padStart(3,'0')}</span>
      <span class="pc-sprite">${m.s}</span>
      <span class="pc-name">${m.name.toUpperCase()}</span>
      <div class="pc-types">${m.t.map(t=>`<span class="t-chip" style="background:${TC[t]||'#555'}">${t.toUpperCase()}</span>`).join('')}</div>
    `;
    card.onclick = () => { if (inTeam) { openModal(m); return; } if (!teamFull) addToTeam(m); };
    card.ondblclick = () => openModal(m);
    grid.appendChild(card);
  });
}

// ===== TEAM =====
function addToTeam(mon) {
  if (team.length >= 6 || team.some(t => t.id === mon.id)) return;
  team.push(mon);
  updateTeam();
}
function removeFromTeam(id) {
  team = team.filter(t => t.id !== id);
  updateTeam();
}
function clearTeam() {
  team = [];
  updateTeam();
  document.getElementById('evalBox').innerHTML = '<div class="eval-empty">Add Pokémon &amp; hit<br>ANALYSE TEAM</div>';
  document.getElementById('evalBox').classList.remove('glowing');
}
function updateTeam() {
  document.getElementById('teamCt').textContent = team.length;
  document.getElementById('evalBtn').disabled = team.length < 1;
  const hp = document.getElementById('headerPreview');
  hp.innerHTML = '';
  for (let i = 0; i < 6; i++) {
    const s = document.createElement('div');
    s.className = 'htp-slot' + (team[i] ? ' filled' : '');
    s.textContent = team[i] ? team[i].s : '';
    hp.appendChild(s);
  }
  const tg = document.getElementById('teamGrid');
  tg.innerHTML = '';
  for (let i = 0; i < 6; i++) {
    const slot = document.createElement('div');
    slot.className = 'team-slot' + (team[i] ? ' filled' : '');
    if (team[i]) {
      const m = team[i];
      slot.innerHTML = `<button class="ts-rm" onclick="removeFromTeam(${m.id})">✖</button>
        <span class="ts-sprite">${m.s}</span>
        <span class="ts-name">${m.name.toUpperCase()}</span>
        <div class="ts-types">${m.t.map(t=>`<span class="t-chip" style="background:${TC[t]||'#555'}">${t.slice(0,3).toUpperCase()}</span>`).join('')}</div>`;
    } else {
      slot.innerHTML = '<span class="empty-txt">EMPTY<br>SLOT</span>';
    }
    tg.appendChild(slot);
  }
  const cov = document.getElementById('coverageRow');
  if (!team.length) { cov.innerHTML = '<span style="font-size:7px;color:var(--text-dim)">Add Pokémon to see coverage</span>'; }
  else {
    const types = [...new Set(team.flatMap(m => m.t))];
    cov.innerHTML = types.map(t => `<span class="cov-tag" style="background:${TC[t]||'#555'}">${t.toUpperCase()}</span>`).join('');
  }
  render();
}

// ===== MODAL =====
function openModal(m) {
  modalMon = m;
  document.getElementById('mSprite').textContent = m.s;
  document.getElementById('mName').textContent = m.name.toUpperCase();
  document.getElementById('mNum').textContent = `#${String(m.id).padStart(3,'0')} · ${m.region.toUpperCase()} · BST ${m.bst}`;
  document.getElementById('mTypes').innerHTML = m.t.map(t=>`<span class="t-chip" style="background:${TC[t]||'#555'};padding:3px 8px;font-size:7px">${t.toUpperCase()}</span>`).join('');
  document.getElementById('mDesc').textContent = m.desc;
  const sn = {hp:'HP',atk:'ATK',def:'DEF',spatk:'SpATK',spdef:'SpDEF',spd:'SPD'};
  document.getElementById('mStats').innerHTML = Object.entries(m.st).map(([k,v]) => `
    <div class="stat-row"><span class="stat-lbl">${sn[k]}</span>
    <div class="stat-bar-bg"><div class="stat-bar" style="width:${Math.round(v/STAT_MAX[k]*100)}%;background:${STAT_COL[k]}"></div></div>
    <span class="stat-val">${v}</span></div>`).join('');
  document.getElementById('mAbilities').innerHTML = [
    ...m.ab.map(a=>`<div class="ability-item"><span class="ability-name">${a}</span><span class="ability-badge">ABILITY</span></div>`),
    `<div class="ability-item"><span class="ability-name">${m.ha}</span><span class="ability-badge hidden">HIDDEN</span></div>`
  ].join('');
  const inTeam = team.some(t => t.id === m.id);
  const btn = document.getElementById('mAddBtn');
  if (inTeam) { btn.textContent = '✖ REMOVE FROM TEAM'; btn.className = 'modal-add-btn remove'; btn.disabled = false; btn.onclick = () => { removeFromTeam(m.id); closeModal(); }; }
  else if (team.length >= 6) { btn.textContent = 'TEAM FULL'; btn.className = 'modal-add-btn'; btn.disabled = true; }
  else { btn.textContent = '➕ ADD TO TEAM'; btn.className = 'modal-add-btn'; btn.disabled = false; btn.onclick = () => { addToTeam(m); closeModal(); }; }
  document.getElementById('mFavBtn').onclick = () => { quickAddFav(m); closeModal(); };
  document.getElementById('modalBg').classList.add('open');
}
function closeModal() { document.getElementById('modalBg').classList.remove('open'); }
function maybeCloseModal(e) { if (e.target === document.getElementById('modalBg')) closeModal(); }

// ===== EVALUATOR =====
const SUPER_EFFECTIVE={fire:['grass','ice','bug','steel'],water:['fire','ground','rock'],grass:['water','ground','rock'],electric:['water','flying'],ice:['grass','ground','flying','dragon'],fighting:['normal','ice','rock','dark','steel'],poison:['grass','fairy'],ground:['fire','electric','poison','rock','steel'],flying:['grass','fighting','bug'],psychic:['fighting','poison'],bug:['grass','psychic','dark'],rock:['fire','ice','flying','bug'],ghost:['psychic','ghost'],dragon:['dragon'],dark:['psychic','ghost'],steel:['ice','rock','fairy'],fairy:['fighting','dragon','dark'],normal:[]};
const WEAK_TO={normal:['fighting'],fire:['water','ground','rock'],water:['grass','electric'],grass:['fire','ice','poison','flying','bug'],electric:['ground'],ice:['fire','fighting','rock','steel'],fighting:['flying','psychic','fairy'],poison:['ground','psychic'],ground:['water','grass','ice'],flying:['electric','ice','rock'],psychic:['bug','ghost','dark'],bug:['fire','flying','rock'],rock:['water','grass','fighting','ground','steel'],ghost:['ghost','dark'],dragon:['ice','dragon','fairy'],dark:['fighting','bug','fairy'],steel:['fire','fighting','ground'],fairy:['poison','steel']};

function evaluateTeam() {
  if (!team.length) return;
  const box = document.getElementById('evalBox');
  box.classList.remove('glowing');
  box.innerHTML = `<div style="text-align:center;padding:20px 0"><div class="dot-anim"><span>▪</span><span>▪</span><span>▪</span></div><p style="font-size:7px;color:var(--text-dim);margin-top:10px">ANALYSING...</p></div>`;
  setTimeout(() => { const r = runAnalysis(); renderEval(r); }, 500);
}

function runAnalysis() {
  const strengths=[], weaknesses=[], tips=[];
  const teamTypes=[...new Set(team.flatMap(m=>m.t))];
  const coveredOffense=[...new Set(teamTypes.flatMap(t=>SUPER_EFFECTIVE[t]||[]))];
  const uncoveredOffense=['fire','water','grass','electric','ice','fighting','ground','rock','flying','psychic','dark','steel','dragon','ghost','fairy','bug'].filter(t=>!coveredOffense.includes(t));
  if(coveredOffense.length>=10) strengths.push(`Excellent offensive coverage — hits ${coveredOffense.length} types super effectively.`);
  else if(coveredOffense.length>=7) strengths.push(`Decent offensive coverage across ${coveredOffense.length} types.`);
  else weaknesses.push(`Limited offense — only ${coveredOffense.length} types covered SE. ${uncoveredOffense.slice(0,3).map(t=>t.toUpperCase()).join(', ')} may wall you.`);

  const weaknessCounts={};
  team.forEach(m=>m.t.forEach(type=>(WEAK_TO[type]||[]).forEach(w=>{weaknessCounts[w]=(weaknessCounts[w]||0)+1})));
  Object.entries(weaknessCounts).filter(([,c])=>c>=3).sort((a,b)=>b[1]-a[1]).forEach(([type,count])=>weaknesses.push(`${type.toUpperCase()} threatens ${count} members — a single ${type}-type could sweep.`));

  const doubleWeakMons=team.filter(m=>{const wks=m.t.flatMap(t=>WEAK_TO[t]||[]);return wks.length!==new Set(wks).size});
  if(doubleWeakMons.length) weaknesses.push(`${doubleWeakMons.map(m=>m.name).join(' & ')} have a double weakness — a SE hit could OHKO them.`);

  const Object_entries_wk=Object.entries(weaknessCounts).filter(([,c])=>c===1);
  if(!Object.entries(weaknessCounts).some(([,c])=>c>=3)&&Object_entries_wk.length<=3) strengths.push('Solid defensive spread — no type threatens more than 2 members.');

  const fastMons=team.filter(m=>m.st.spd>=90), slowMons=team.filter(m=>m.st.spd<50);
  const avgSpd=Math.round(team.reduce((a,m)=>a+m.st.spd,0)/team.length);
  if(fastMons.length>=3) strengths.push(`High-tempo speed — ${fastMons.map(m=>m.name).slice(0,3).join(', ')} all hit 90+ Speed.`);
  else if(slowMons.length>=3) weaknesses.push(`Sluggish team — ${slowMons.map(m=>m.name).join(', ')} are all below 50 Speed.`);
  else if(avgSpd<65) weaknesses.push(`Below-average avg Speed of ${avgSpd}. Fast threats will outspeed consistently.`);

  const highBST=team.filter(m=>m.bst>=500), lowBST=team.filter(m=>m.bst<=350);
  if(highBST.length>=3) strengths.push(`Power house roster — ${highBST.slice(0,3).map(m=>m.name).join(', ')} all hit 500+ BST.`);
  if(lowBST.length>=2) weaknesses.push(`${lowBST.map(m=>m.name).join(' & ')} drag the power down with sub-350 BST.`);

  const physMons=team.filter(m=>m.st.atk>=90), specMons=team.filter(m=>m.st.spatk>=90);
  if(physMons.length>=2&&specMons.length>=2) strengths.push(`Balanced mixed offense forces foes to maintain both defensive stats.`);
  else if(physMons.length>=4&&specMons.length<=1) weaknesses.push(`Heavy physical bias — one physical wall could shut down multiple members.`);
  else if(specMons.length>=4&&physMons.length<=1) weaknesses.push(`Heavy special bias — Blissey or Umbreon can hard-wall multiple members.`);

  const bulky=team.filter(m=>(m.st.hp+m.st.def+m.st.spdef)>=230);
  const frail=team.filter(m=>(m.st.hp+m.st.def+m.st.spdef)<=160);
  if(bulky.length>=3) strengths.push(`Durable core — ${bulky.map(m=>m.name).join(', ')} have 230+ combined bulk.`);
  if(frail.length>=3) weaknesses.push(`${frail.map(m=>m.name).join(', ')} are quite frail — priority moves are a serious threat.`);

  const powerAbs=['Guts','Huge Power','Technician','Sheer Force','Moxie','Speed Boost','Magic Bounce','Drizzle','Sand Stream','Prankster','Multiscale','Intimidate','No Guard'];
  const powerAbMons=team.filter(m=>[...m.ab,m.ha].some(a=>powerAbs.includes(a)));
  if(powerAbMons.length>=2) strengths.push(`Strong abilities — ${powerAbMons.slice(0,2).map(m=>{const a=[...m.ab,m.ha].find(x=>powerAbs.includes(x));return`${m.name} (${a})`}).join(', ')}.`);

  const weatherSetter=team.find(m=>[...m.ab,m.ha].some(a=>['Drizzle','Sand Stream'].includes(a)));
  const weatherAbuser=team.find(m=>[...m.ab,m.ha].some(a=>['Swift Swim','Chlorophyll','Sand Rush'].includes(a)));
  if(weatherSetter&&weatherAbuser) strengths.push(`Weather synergy — ${weatherSetter.name} sets, ${weatherAbuser.name} abuses for double Speed.`);

  const johtoCount=team.filter(m=>m.region==='johto').length;
  const kantoCount=team.filter(m=>m.region==='kanto').length;
  if(johtoCount>0&&kantoCount>0) strengths.push(`Mixed-region team with ${johtoCount} Johto + ${kantoCount} Kanto Pokémon — maximises the available gene pool.`);
  else if(kantoCount===team.length) tips.push('Pure Kanto team — consider a Johto legendary for a power boost.');

  const typeCounts={};
  team.forEach(m=>m.t.forEach(t=>{typeCounts[t]=(typeCounts[t]||0)+1}));
  Object.entries(typeCounts).filter(([,c])=>c>=3).forEach(([t,c])=>weaknesses.push(`${c}× ${t.toUpperCase()} types is risky — one coverage move threatens multiple members.`));

  const uniqueTypes=[...new Set(team.flatMap(m=>m.t))].length;
  if(uniqueTypes>=8) strengths.push(`High type diversity (${uniqueTypes} types) — hard to predict and counter.`);
  else if(uniqueTypes<=3&&team.length>=4) weaknesses.push(`Very low type diversity (${uniqueTypes} types) — predictable and easy to counter.`);

  let score=5;
  score+=Math.min(strengths.length*0.4,3);
  score-=Math.min(weaknesses.length*0.5,3);
  score=Math.max(1,Math.min(10,Math.round(score*10)/10));

  const ratings=[{min:9,label:'Elite Squad'},{min:8,label:'Solid Competitive Build'},{min:7,label:'Well-Rounded Core'},{min:6,label:'Decent but Patchable'},{min:5,label:'Work in Progress'},{min:3,label:'Needs Rebuilding'},{min:0,label:'Start Over, Trainer'}];
  const rating=ratings.find(r=>score>=r.min)?.label||'Unrated';
  const avgBST=Math.round(team.reduce((a,m)=>a+m.bst,0)/team.length);
  let verdict='';
  if(score>=8){verdict=`Strong build with good synergy. Avg BST of ${avgBST} is ${avgBST>=490?'excellent':'healthy'}. ${weaknesses.length?'Address the flagged weaknesses and this becomes a top-tier team.':'Near-perfect construction.'}`}
  else if(score>=6){verdict=`Serviceable team that covers most bases. Avg BST ${avgBST} — ${avgBST>=470?'power is on your side':'consider swapping weak links'}. Patch the flagged weaknesses to compete at higher levels.`}
  else{verdict=`Significant issues holding this team back. Avg BST ${avgBST} is ${avgBST<430?'low — prioritise evolved forms':'okay but synergy is the problem'}. Focus on type coverage and removing the weakest links first.`}
  if(tips.length) verdict+=' Tip: '+tips[0];
  return{score,rating,strengths,weaknesses,verdict};
}

function renderEval({score,rating,strengths,weaknesses,verdict}){
  const box=document.getElementById('evalBox');
  const sc=score>=7?'var(--green)':score>=5?'var(--yellow)':'var(--red)';
  let html='<div class="eval-content">';
  html+=`<div class="eval-score-row"><span class="big-score" style="color:${sc}">${score}/10</span><div><div style="font-size:13px;color:var(--text);line-height:1.3">${rating}</div><div class="score-label">${team.length} MON · AVG BST ${Math.round(team.reduce((a,m)=>a+m.bst,0)/team.length)}</div></div></div>`;
  if(strengths.length) html+=`<div class="eval-section"><div class="eval-section-title good">▲ STRENGTHS (${strengths.length})</div>${strengths.map(s=>`<p style="margin-bottom:8px;padding-left:10px;border-left:2px solid var(--green-dim)">▲ ${s}</p>`).join('')}</div>`;
  if(weaknesses.length) html+=`<div class="eval-section"><div class="eval-section-title bad">▼ WEAKNESSES (${weaknesses.length})</div>${weaknesses.map(w=>`<p style="margin-bottom:8px;padding-left:10px;border-left:2px solid rgba(252,93,93,0.4)">▼ ${w}</p>`).join('')}</div>`;
  html+=`<div class="eval-section"><div class="eval-section-title neutral">◆ VERDICT</div><p>${verdict}</p></div></div>`;
  box.innerHTML=html;
  box.classList.add('glowing');
}

// ===== TRAINER CREATOR =====
const SKIN_TONES=['#FDDBB4','#F5C28A','#E8A96B','#C88050','#A0603A','#7A3A20','#4A2010'];
const HAIR_COLORS=['#1a0a00','#3d1a00','#7a3a00','#c8a040','#f0e040','#e05030','#d030b0','#2050e0','#208050','#e0e0e0'];
const HAIR_STYLES=['SHORT','LONG','SPIKY','CURLY','BALD'];
const OUTFITS=['RED','BLUE','GREEN','YELLOW','BLACK','WHITE','PURPLE'];

let trainerOpts={skin:0,hair:0,hairStyle:0,outfit:0};

function initTrainer(){
  const ss=document.getElementById('skinSwatches');
  SKIN_TONES.forEach((c,i)=>{
    const s=document.createElement('div');
    s.className='swatch'+(i===trainerOpts.skin?' active':'');
    s.style.background=c;
    s.onclick=()=>{trainerOpts.skin=i;document.querySelectorAll('#skinSwatches .swatch').forEach((x,j)=>x.classList.toggle('active',j===i));drawTrainer()};
    ss.appendChild(s);
  });
  const hs=document.getElementById('hairSwatches');
  HAIR_COLORS.forEach((c,i)=>{
    const s=document.createElement('div');
    s.className='swatch'+(i===trainerOpts.hair?' active':'');
    s.style.background=c;
    s.onclick=()=>{trainerOpts.hair=i;document.querySelectorAll('#hairSwatches .swatch').forEach((x,j)=>x.classList.toggle('active',j===i));drawTrainer()};
    hs.appendChild(s);
  });
  const hso=document.getElementById('hairStyleOpts');
  HAIR_STYLES.forEach((h,i)=>{
    const b=document.createElement('button');
    b.className='opt-btn'+(i===trainerOpts.hairStyle?' active':'');
    b.textContent=h;
    b.onclick=()=>{trainerOpts.hairStyle=i;document.querySelectorAll('#hairStyleOpts .opt-btn').forEach((x,j)=>x.classList.toggle('active',j===i));drawTrainer()};
    hso.appendChild(b);
  });
  const oo=document.getElementById('outfitOpts');
  OUTFITS.forEach((o,i)=>{
    const b=document.createElement('button');
    b.className='opt-btn'+(i===trainerOpts.outfit?' active':'');
    b.textContent=o;
    b.onclick=()=>{trainerOpts.outfit=i;document.querySelectorAll('#outfitOpts .opt-btn').forEach((x,j)=>x.classList.toggle('active',j===i));drawTrainer()};
    oo.appendChild(b);
  });
  if(trainerData){
    trainerOpts={...trainerData.opts};
    document.getElementById('trainerNameInput').value=trainerData.name||'';
    document.getElementById('trainerQuote').value=trainerData.quote||'';
    updateAllSwatchOpts();
    showSavedTrainer();
  }
  drawTrainer();
}

function updateAllSwatchOpts(){
  document.querySelectorAll('#skinSwatches .swatch').forEach((x,i)=>x.classList.toggle('active',i===trainerOpts.skin));
  document.querySelectorAll('#hairSwatches .swatch').forEach((x,i)=>x.classList.toggle('active',i===trainerOpts.hair));
  document.querySelectorAll('#hairStyleOpts .opt-btn').forEach((x,i)=>x.classList.toggle('active',i===trainerOpts.hairStyle));
  document.querySelectorAll('#outfitOpts .opt-btn').forEach((x,i)=>x.classList.toggle('active',i===trainerOpts.outfit));
}

function drawTrainer(targetId='trainerCanvas'){
  const canvas=document.getElementById(targetId);
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const W=canvas.width, H=canvas.height;
  const scale=W/160;
  ctx.clearRect(0,0,W,H);
  ctx.imageSmoothingEnabled=false;

  const skin=SKIN_TONES[trainerOpts.skin];
  const hair=HAIR_COLORS[trainerOpts.hair];
  const outfitColors=[['#e03020','#c02010'],['#2050c0','#1030a0'],['#208040','#106030'],['#d0b020','#a08010'],['#202020','#101010'],['#e8e8e8','#c0c0c0'],['#8020c0','#601090']];
  const [oc1,oc2]=outfitColors[trainerOpts.outfit];

  const px=(x,y,w,h,c)=>{ctx.fillStyle=c;ctx.fillRect(x*scale,y*scale,w*scale,h*scale)};

  // Body / torso
  px(56,80,48,50,oc1);
  px(60,90,40,35,oc2);

  // Collar
  px(72,78,16,10,skin);

  // Arms
  px(36,80,22,40,oc1);
  px(102,80,22,40,oc1);

  // Hands
  px(36,118,20,12,skin);
  px(104,118,20,12,skin);

  // Legs
  px(58,128,18,42,oc2==='#101010'?'#1a1a3a':'#1a1a1a');
  px(84,128,18,42,oc2==='#101010'?'#1a1a3a':'#1a1a1a');

  // Shoes
  px(54,168,26,16,'#101010');
  px(80,168,26,16,'#101010');

  // Neck
  px(68,68,24,16,skin);

  // Head
  px(48,28,64,50,skin);

  // Ears
  px(44,44,10,16,skin);
  px(106,44,10,16,skin);

  // Eyes
  ctx.fillStyle='#fff';
  ctx.fillRect(60*scale,48*scale,14*scale,10*scale);
  ctx.fillRect(86*scale,48*scale,14*scale,10*scale);
  ctx.fillStyle='#1a0a00';
  ctx.fillRect(65*scale,50*scale,7*scale,7*scale);
  ctx.fillRect(91*scale,50*scale,7*scale,7*scale);
  // Eye shine
  ctx.fillStyle='#ffffff';
  ctx.fillRect(67*scale,51*scale,2*scale,2*scale);
  ctx.fillRect(93*scale,51*scale,2*scale,2*scale);

  // Nose
  px(76,60,8,6,SKIN_TONES[Math.min(trainerOpts.skin+2,SKIN_TONES.length-1)]);

  // Mouth - smile
  ctx.fillStyle='#8a3020';
  ctx.fillRect(66*scale,66*scale,28*scale,4*scale);
  ctx.fillStyle='#fff';
  ctx.fillRect(68*scale,66*scale,24*scale,3*scale);

  // HAIR
  const hs=trainerOpts.hairStyle;
  ctx.fillStyle=hair;
  if(hs===0){// SHORT
    ctx.fillRect(48*scale,22*scale,64*scale,16*scale); // top
    ctx.fillRect(44*scale,28*scale,10*scale,20*scale); // left
    ctx.fillRect(106*scale,28*scale,10*scale,20*scale); // right
    ctx.fillRect(48*scale,22*scale,64*scale,10*scale);
  } else if(hs===1){// LONG
    ctx.fillRect(48*scale,22*scale,64*scale,12*scale);
    ctx.fillRect(44*scale,28*scale,12*scale,70*scale); // long sides
    ctx.fillRect(104*scale,28*scale,12*scale,70*scale);
    ctx.fillRect(52*scale,22*scale,56*scale,10*scale);
  } else if(hs===2){// SPIKY
    ctx.fillRect(48*scale,26*scale,64*scale,12*scale);
    // spikes
    [[54,8],[68,4],[82,6],[96,10]].forEach(([x,y])=>{
      ctx.beginPath();ctx.moveTo((x-6)*scale,26*scale);ctx.lineTo(x*scale,y*scale);ctx.lineTo((x+6)*scale,26*scale);ctx.fill();
    });
    ctx.fillRect(44*scale,28*scale,10*scale,18*scale);
    ctx.fillRect(106*scale,28*scale,10*scale,18*scale);
  } else if(hs===3){// CURLY
    for(let cx2=50;cx2<110;cx2+=12){
      for(let cy2=14;cy2<34;cy2+=10){
        ctx.beginPath();ctx.arc(cx2*scale,cy2*scale,6*scale,0,Math.PI*2);ctx.fill();
      }
    }
    ctx.fillRect(44*scale,28*scale,10*scale,18*scale);
    ctx.fillRect(106*scale,28*scale,10*scale,18*scale);
  }
  // BALD = no hair drawn

  // Hat brim (always)
  if(hs!==1){
    ctx.fillStyle=oc2;
    ctx.fillRect(44*scale,34*scale,72*scale,6*scale);
    ctx.fillStyle=oc1;
    ctx.fillRect(56*scale,20*scale,48*scale,16*scale);
    ctx.fillStyle='#ffffff';
    ctx.fillRect(60*scale,24*scale,40*scale,8*scale);
  }
}

function saveTrainer(){
  const name=document.getElementById('trainerNameInput').value.trim()||'TRAINER';
  const quote=document.getElementById('trainerQuote').value.trim()||'Ready to battle!';
  trainerData={name,quote,opts:{...trainerOpts}};
  localStorage.setItem('pkmn_trainer',JSON.stringify(trainerData));
  showSavedTrainer();
  // flash
  const btn=document.querySelector('.save-trainer-btn');
  btn.textContent='✓ SAVED!';
  setTimeout(()=>btn.textContent='💾 SAVE TRAINER',1500);
}

function showSavedTrainer(){
  if(!trainerData) return;
  const card=document.getElementById('trainerCardSaved');
  card.style.display='block';
  document.getElementById('savedTrainerName').textContent=trainerData.name.toUpperCase();
  document.getElementById('savedTrainerQuote').textContent='"'+trainerData.quote+'"';
  setTimeout(()=>{
    const saved=document.getElementById('trainerCanvasSaved');
    const main=document.getElementById('trainerCanvas');
    const ctx=saved.getContext('2d');
    ctx.imageSmoothingEnabled=false;
    ctx.drawImage(main,0,0,saved.width,saved.height);
  },100);
}

// ===== FAVOURITES =====
function populateFavSelect(){
  const allSort=[...ALL_MONS].sort((a,b)=>a.id-b.id);
  const sel=document.getElementById('favSelect');
  const regionSel=document.getElementById('favRegionSelect');
  const region=regionSel.value;
  sel.innerHTML='';
  allSort.filter(m=>region==='all'||m.region===region).forEach(m=>{
    const o=document.createElement('option');
    o.value=m.id;
    o.textContent=`#${String(m.id).padStart(3,'0')} ${m.name} (${m.region})`;
    sel.appendChild(o);
  });
}

function addFavourite(){
  const sel=document.getElementById('favSelect');
  const reason=document.getElementById('favReason').value.trim();
  if(!sel.value||!reason){alert('Please select a Pokémon and write your reason!');return;}
  const mon=ALL_MONS.find(m=>m.id===parseInt(sel.value));
  if(!mon) return;
  const fav={id:mon.id,name:mon.name,s:mon.s,t:mon.t,region:mon.region,reason,date:new Date().toLocaleDateString()};
  favourites.unshift(fav);
  localStorage.setItem('pkmn_favs',JSON.stringify(favourites));
  document.getElementById('favReason').value='';
  renderFavs();
}

function quickAddFav(m){
  const reason=prompt(`Why do you love ${m.name}?`)||'A true favourite!';
  const fav={id:m.id,name:m.name,s:m.s,t:m.t,region:m.region,reason,date:new Date().toLocaleDateString()};
  favourites.unshift(fav);
  localStorage.setItem('pkmn_favs',JSON.stringify(favourites));
}

function deleteFav(idx){
  favourites.splice(idx,1);
  localStorage.setItem('pkmn_favs',JSON.stringify(favourites));
  renderFavs();
}

function renderFavs(){
  const grid=document.getElementById('favsGrid');
  if(!favourites.length){grid.innerHTML='<div class="fav-empty">No favourites yet!<br><br>Add a Pokémon you love and write why it\'s special to you.</div>';return;}
  grid.innerHTML=favourites.map((f,i)=>`
    <div class="fav-card">
      <button class="fav-del" onclick="deleteFav(${i})">✖</button>
      <div class="fav-card-top">
        <span class="fav-sprite">${f.s}</span>
        <div class="fav-info">
          <span class="fav-name">${f.name.toUpperCase()}</span>
          <span class="fav-num">#${String(f.id).padStart(3,'0')} · ${f.region.toUpperCase()}</span>
          <div class="fav-types">${f.t.map(t=>`<span class="t-chip" style="background:${TC[t]||'#555'}">${t.slice(0,3).toUpperCase()}</span>`).join('')}</div>
        </div>
      </div>
      <div class="fav-reason">${f.reason}</div>
      <div class="fav-date">Added ${f.date}</div>
    </div>`).join('');
}

